{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mintonix rally manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "matchId", "title", "players", "sourceDurationSeconds", "rallies"],
  "properties": {
    "version": { "const": 1 },
    "matchId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "players": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "rallies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "game", "startSeconds", "endSeconds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "game": { "type": "integer", "minimum": 1, "maximum": 3 },
          "startSeconds": { "type": "number", "minimum": 0 },
          "endSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "scoreBefore": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
