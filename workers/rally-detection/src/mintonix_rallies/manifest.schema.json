{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mintonix rally manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "matchId",
    "title",
    "players",
    "source",
    "rallies"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "matchId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "players": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "description": "The published video every rally timestamp refers to. Playback embeds this video; media is never re-hosted.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "videoId",
        "durationSeconds"
      ],
      "properties": {
        "provider": {
          "const": "youtube"
        },
        "videoId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{11}$"
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "rallies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "game",
          "startSeconds",
          "endSeconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "game": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "endSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "scoreBefore": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
