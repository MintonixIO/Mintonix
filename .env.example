# The web preview needs no environment variables.
# Natural-language rally search. Server-only; never use a NEXT_PUBLIC_ prefix.
# Without a key, search falls back to approximate local keyword suggestions.
OPENROUTER_API_KEY=
OPENROUTER_SEARCH_MODEL=google/gemini-2.5-flash-lite

# Optional: read matches from another directory instead of the published set
# in content/matches. Put this setting in .env.local.
# The directory contains <matchId>/match.json (and optionally analysis.json);
# playback embeds YouTube. Media stays outside Git. No NEXT_PUBLIC_ prefix.
MINTONIX_LOCAL_MATCHES_DIR=

# Optional: the public origin used in canonical links, the sitemap and share
# previews. Defaults to https://mintonix.io.
SITE_URL=
